{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "OPENAI_API_KEY",
    "OPENAI_MODEL",
    "DATABASE_URL",
    "COOKIE_DOMAIN",
    "SESSION_TTL_DAYS",
    "R2_ACCOUNT_TOKEN",
    "R2_ACCOUNT_ID",
    "S3_ENDPOINT",
    "R2_BUCKET_NAME",
    "R2_ACCESS_KEY_ID",
    "R2_SECRET_ACCESS_KEY",
    "NEXT_PUBLIC_WEB_URL",
    "NEXT_PUBLIC_ADMIN_URL",
    "NEXT_PUBLIC_API_URL",
    "API_URL",
    "PORT",
    "CORS_ORIGINS",
    "APP_VERSION"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": []
    }
  }
}
