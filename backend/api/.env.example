# Orion API — copy to backend/api/.env for local dev
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://user:password@host/db?sslmode=require
# Browser origins allowed to call the API with cookies (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
APP_VERSION=dev
# Session cookie: parent domain in prod so web/admin/api share it (leave empty locally)
COOKIE_DOMAIN=
SESSION_TTL_DAYS=30
# AI (health check scoring, document generation, chat)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Cloudflare R2 (partner logos, documents)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Email (Resend). Unset locally: emails are printed to the console instead of sent.
RESEND_API_KEY=
EMAIL_FROM="ORION <no-reply@mail.orionadvisorylimited.com>"
# Public URL of the founder web app, used for links in emails
WEB_APP_URL=http://localhost:3000
